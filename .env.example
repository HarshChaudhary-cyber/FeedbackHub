# ==============================================================================
# FeedbackHub — Environment Variables Example Manifest
# Copy this file to .env for local development: cp .env.example .env
# NEVER COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Base domain used for subdomain extraction (e.g., localhost or feedbackhub.com)
APP_BASE_DOMAIN=localhost
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Default local PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/feedbackhub_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/feedbackhub_dev?schema=public"

# ------------------------------------------------------------------------------
# 3. Session & Authentication Security
# ------------------------------------------------------------------------------
# High-entropy random 64-character secret used to sign session cookies
SESSION_SECRET="change-this-to-a-secure-random-64-character-string-in-production"
SESSION_COOKIE_NAME="feedbackhub_sid"
SESSION_MAX_AGE_SECONDS=604800 # 7 days
SESSION_COOKIE_DOMAIN="" # Leave blank for localhost; use ".feedbackhub.com" in production

# ------------------------------------------------------------------------------
# 4. Redis Cache & Session Store
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 5. Object Storage (S3-Compatible / MinIO for Local Dev)
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="feedbackhub-assets"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ------------------------------------------------------------------------------
# 6. Transactional Email (Resend)
# ------------------------------------------------------------------------------
# Set EMAIL_MOCK_MODE=true to log emails to console instead of sending live
EMAIL_MOCK_MODE="true"
RESEND_API_KEY="re_mock_api_key_placeholder"
EMAIL_FROM="FeedbackHub <notifications@feedbackhub.com>"

# ------------------------------------------------------------------------------
# 7. Subscription & Payments (Razorpay)
# ------------------------------------------------------------------------------
# Disabled by default during early development phases
PAYMENTS_ENABLED="false"
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# ------------------------------------------------------------------------------
# 8. Rate Limiting & Telemetry
# ------------------------------------------------------------------------------
THROTTLE_TTL=60 # seconds
THROTTLE_LIMIT=100 # requests per TTL window
PUBLIC_SUBMIT_THROTTLE_LIMIT=20 # public feedback submissions per minute
