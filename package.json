{
  "name": "feedbackhub-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FeedbackHub — Multi-tenant B2B SaaS feedback management platform",
  "author": "FeedbackHub Team",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @feedbackhub/web --filter @feedbackhub/api --parallel dev",
    "dev:web": "pnpm --filter @feedbackhub/web dev",
    "dev:api": "pnpm --filter @feedbackhub/api dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "clean": "node scripts/clean.mjs",
    "db:generate": "pnpm --filter @feedbackhub/database db:generate",
    "db:migrate": "pnpm --filter @feedbackhub/database db:migrate",
    "db:seed": "pnpm --filter @feedbackhub/database db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
